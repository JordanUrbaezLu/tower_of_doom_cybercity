}
function hub_pap_yaw( hub )
{
	switch ( trial_layout_index( hub ) )
	{
		case 0: return 90;   // THE RING (W wall PaP, E wall crate)
		case 1: return 270;   // THE KENNEL (E wall PaP, W wall crate)
		case 2: return 270;   // THE FIRING LINE (E wall PaP, S wall crate)
		case 3: return 270;   // THE ALTAR (E wall PaP, W wall crate)
		case 4: return 180;   // THE MAZE (S wall PaP, W wall crate)
		case 5: return 359.999;   // THE GAUNTLET (N wall PaP, S wall crate)
		case 6: return 90;   // THE THRONE (W wall PaP, S wall crate)
	}
	return 90;
}
