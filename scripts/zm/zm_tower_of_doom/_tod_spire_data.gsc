		case 2: return ( 10600, -200, z );   // THE FIRING LINE (E wall PaP, S wall crate)
		case 3: return ( 10600, -160, z );   // THE ALTAR (E wall PaP, W wall crate)
		case 4: return ( 10440, -160, z );   // THE MAZE (S wall PaP, W wall crate)
		case 5: return ( 10120, 360, z );   // THE GAUNTLET (N wall PaP, S wall crate)
