		case 1: return ( 10656, -200, z );   // THE KENNEL (E wall PaP, W wall crate)
		case 2: return ( 10656, -200, z );   // THE FIRING LINE (E wall PaP, S wall crate)
		case 3: return ( 10656, -160, z );   // THE ALTAR (E wall PaP, W wall crate)
		case 4: return ( 10440, -216, z );   // THE MAZE (S wall PaP, W wall crate)
		case 5: return ( 10120, 416, z );   // THE GAUNTLET (N wall PaP, S wall crate)
		case 6: return ( 9824, 200, z );   // THE THRONE (W wall PaP, S wall crate)
	}
	return ( 9824, 200, z );
}
